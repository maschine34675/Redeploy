<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Shared.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>maschine-Redeploy.Client</AssemblyName>
    <RootNamespace>Redeploy</RootNamespace>
    <Description>Respawn in raid after death without equipment</Description>
    <Company>https://github.com/maschine34675/Redeploy</Company>
    <Authors>maschine</Authors>
    <SPTModType>Client</SPTModType>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private="false": the Core DLL deploys itself flat to BepInEx/plugins via its own
         SPTClientDeploy target; a copy in this project's output would deploy a duplicate. -->
    <ProjectReference Include="..\Redeploy.Core\Redeploy.Core.csproj" Private="false" />
  </ItemGroup>

  <!-- Driver skew check (docs/RESPAWN-API.md 3.9): stamp the Core version this driver is
       built against; Plugin.Awake compares it with the installed Core. -->
  <Import Project="..\Redeploy.Core\CoreVersion.props" />
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>$(RedeployCoreBuiltAgainstKey)</_Parameter1>
      <_Parameter2>$(RedeployCoreVersion)</_Parameter2>
    </AssemblyAttribute>
    <Compile Include="..\drivers\CoreVersionGate.cs" Link="Drivers\CoreVersionGate.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DissonanceVoip" />
    <Reference Include="spt-common" />
    <Reference Include="spt-reflection" />
    <Reference Include="Assembly-CSharp" />
    <Reference Include="Comfort" />
    <Reference Include="Comfort.Unity" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="Sirenix.Serialization" />
    <Reference Include="UnityEngine.AIModule" />
    <Reference Include="UnityEngine.TextRenderingModule" />
    <Reference Include="UnityEngine" />
    <Reference Include="UnityEngine.CoreModule" />
    <Reference Include="UnityEngine.IMGUIModule" />
    <Reference Include="UnityEngine.InputLegacyModule" />
    <Reference Include="UnityEngine.PhysicsModule" />
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
  </ItemGroup>

</Project>
