<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Shared.props" />
  <Import Project="CoreVersion.props" />

  <PropertyGroup>
    <!-- Core's own version line (CoreVersion.props), not Redeploy's Shared.props version. -->
    <Version>$(RedeployCoreVersion)</Version>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>maschine-Redeploy.Core</AssemblyName>
    <RootNamespace>Redeploy.Core</RootNamespace>
    <Description>Respawn engine shared library (used by Redeploy and ArenaMode)</Description>
    <Company>https://github.com/maschine34675/Redeploy</Company>
    <Authors>maschine</Authors>
    <SPTModType>Client</SPTModType>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="DissonanceVoip" />
    <Reference Include="spt-common" />
    <Reference Include="spt-reflection" />
    <Reference Include="Assembly-CSharp" />
    <Reference Include="Comfort" />
    <Reference Include="Comfort.Unity" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="Sirenix.Serialization" />
    <Reference Include="UnityEngine.AIModule" />
    <Reference Include="UnityEngine.TextRenderingModule" />
    <Reference Include="UnityEngine" />
    <Reference Include="UnityEngine.CoreModule" />
    <Reference Include="UnityEngine.IMGUIModule" />
    <Reference Include="UnityEngine.InputLegacyModule" />
    <Reference Include="UnityEngine.PhysicsModule" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
  </ItemGroup>

</Project>
