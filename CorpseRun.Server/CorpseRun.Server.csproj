<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Shared.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>CorpseRun</RootNamespace>
    <AssemblyName>maschine-CorpseRun.Server</AssemblyName>
    <Company>https://github.com/maschine34675/CorpseRun</Company>
    <Authors>maschine</Authors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <OutputPath>..\build\server\$(Configuration)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <SPTUserMods>$(SPTUserPath)\user\mods\</SPTUserMods>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.0.5" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.5" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.5" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.0.5" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="DeployToSpt" AfterTargets="Build" Condition="Exists('$(SPTUserMods)')">
    <MakeDir Directories="$(SPTUserMods)CorpseRun\" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(SPTUserMods)CorpseRun\" SkipUnchangedFiles="true" />
  </Target>

</Project>
