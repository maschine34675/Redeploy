<!-- Covers the pure pieces of the respawn engine: the signal dispatcher (per-subscriber
     isolation, depth, snapshot semantics) and the RunRespawn preflight matrix. Everything
     else in Core is Harmony against Unity/EFT types that cannot load outside the game, so
     it stays in-game (docs/RESPAWN-API.md, section 10) — except the transpiler instruction
     rewrite in Compat/FindObjectOfTypeRewrite.cs and Compat/GenericStaticCallRewrite.cs
     (Harmony's CodeInstruction/MethodInfo plumbing against synthetic stand-ins, not against
     Unity/EFT itself, so HarmonyX below is for those two files only) and
     Compat/ArrayLivenessFilter.cs (plain array logic with an injected predicate, same reason
     StaleSamplerRegistry and SceneLookupCache are covered here), and
     Compat/DoorDashFollowRule.cs (the decision behind DoorDashCompatHelper, plain booleans). -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- Not deployed anywhere; keep it out of the mod output folders. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Contract checks read the BUILT Core and the installed consumers as metadata only. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
    <!-- Source guards parse Core's files (syntax only, no references needed). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- Same package BepInEx.Core pulls in Core itself; only CodeInstruction/OpCodes are used
         here, driven with synthetic MethodInfo/Type stand-ins instead of the game's types. -->
    <PackageReference Include="HarmonyX" Version="2.16.1" />
  </ItemGroup>

  <!-- Linked, not referenced: Redeploy.Core itself cannot load outside the game. -->
  <ItemGroup>
    <Compile Include="..\Redeploy.Core\Engine\SignalDispatcher.cs" Link="Engine\SignalDispatcher.cs" />
    <Compile Include="..\Redeploy.Core\Engine\RespawnPreflight.cs" Link="Engine\RespawnPreflight.cs" />
    <Compile Include="..\Redeploy.Core\Engine\RespawnClaimLogic.cs" Link="Engine\RespawnClaimLogic.cs" />
    <Compile Include="..\Redeploy.Core\Engine\AvailabilityRule.cs" Link="Engine\AvailabilityRule.cs" />
    <Compile Include="..\drivers\CoreVersionGate.cs" Link="Drivers\CoreVersionGate.cs" />
    <Compile Include="..\Redeploy.Core\Spawning\NearSpawnPolicy.cs" Link="Spawning\NearSpawnPolicy.cs" />
    <Compile Include="..\Redeploy.Core\Engine\PipelineStages.cs" Link="Engine\PipelineStages.cs" />
    <Compile Include="..\Redeploy.Core\Compat\StaleSamplerRegistry.cs" Link="Compat\StaleSamplerRegistry.cs" />
    <Compile Include="..\Redeploy.Core\Compat\SceneLookupCache.cs" Link="Compat\SceneLookupCache.cs" />
    <Compile Include="..\Redeploy.Core\Compat\FindObjectOfTypeRewrite.cs" Link="Compat\FindObjectOfTypeRewrite.cs" />
    <Compile Include="..\Redeploy.Core\Compat\GenericStaticCallRewrite.cs" Link="Compat\GenericStaticCallRewrite.cs" />
    <Compile Include="..\Redeploy.Core\Compat\ArrayLivenessFilter.cs" Link="Compat\ArrayLivenessFilter.cs" />
    <Compile Include="..\Redeploy.Core\Compat\DoorDashFollowRule.cs" Link="Compat\DoorDashFollowRule.cs" />
    <Compile Include="..\Redeploy.Core\Compat\FovFixScope.cs" Link="Compat\FovFixScope.cs" />
    <Compile Include="..\Redeploy.Core\Compat\ManimalAmmoScope.cs" Link="Compat\ManimalAmmoScope.cs" />
    <Compile Include="..\Redeploy.Core\Compat\MagazineCheckScope.cs" Link="Compat\MagazineCheckScope.cs" />
    <Compile Include="..\Redeploy.Client\Services\RespawnCooldown.cs" Link="Client\RespawnCooldown.cs" />
  </ItemGroup>

</Project>
