<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CompatSource Condition="'$(CompatSource)' == ''">../../Redeploy.Core/Compat</CompatSource>
    <NoWarn>$(NoWarn);CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" /><Compile Include="Fixtures.cs" /><Compile Include="PublishedMetadata.cs" />
    <Compile Include="$(CompatSource)/DynamicMapsCompatHelper.cs" Link="Production/DynamicMapsCompatHelper.cs" />
    <Compile Include="$(CompatSource)/DynamicMapsProviderRebind.cs" Link="Production/DynamicMapsProviderRebind.cs" />
    <Reference Include="Mono.Cecil"><HintPath>../../../../BepInEx/core/Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>
</Project>
