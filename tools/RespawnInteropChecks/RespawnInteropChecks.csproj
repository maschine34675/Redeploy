<!-- Offline model of the consumer interop file (docs/RESPAWN-API.md, section 8.3): the
     unmodified interop/RedeployRespawnInterop.cs is compiled against stand-ins for Unity,
     Comfort and EFT, bound to a mock facade with the literal v1 surface, and driven through
     scripted raids. Run it with dotnet run (project tools/RespawnInteropChecks, Release). -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RespawnInteropChecks</RootNamespace>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The production file, verbatim; its namespace stays YourMod.Interop. -->
    <Compile Include="..\..\interop\RedeployRespawnInterop.cs" Link="Production\RedeployRespawnInterop.cs" />
  </ItemGroup>

</Project>
