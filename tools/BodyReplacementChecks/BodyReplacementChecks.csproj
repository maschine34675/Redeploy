<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ProductionCoreRoot Condition="'$(ProductionCoreRoot)' == ''">../../Redeploy.Core/Compat</ProductionCoreRoot>
    <ArenaScopePath Condition="'$(ArenaScopePath)' == ''">../../../ArenaMode/ArenaMode.Client/Compat/ArenaMedicalBodyScope.cs</ArenaScopePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="StandIns.cs" />
    <Compile Include="$(ProductionCoreRoot)/BodyReplacementContext.cs" Link="Production/BodyReplacementContext.cs" />
    <Compile Include="$(ProductionCoreRoot)/BodyReplacementCompatibility.cs" Link="Production/BodyReplacementCompatibility.cs" />
    <Compile Include="$(ArenaScopePath)" Link="Production/ArenaMedicalBodyScope.cs" />
  </ItemGroup>
</Project>
