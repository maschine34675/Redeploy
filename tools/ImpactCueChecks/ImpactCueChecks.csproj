<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ImpactCue-UI-MOD</AssemblyName><Version>2.0.3</Version>
    <ProductionRoot Condition="'$(ProductionRoot)' == ''">../../Redeploy.Core/Compat</ProductionRoot>
    <SptRoot Condition="'$(SptRoot)' == ''">../../../..</SptRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs"/><Compile Include="StandIns.cs"/><Compile Include="ForeignFixture.cs"/><Compile Include="PublishedMetadata.cs"/>
    <Compile Include="$(ProductionRoot)/ImpactCue/*.cs" Link="Production/%(Filename)%(Extension)"/>
    <Compile Include="$(ProductionRoot)/BodyReplacementContext.cs" Link="Production/BodyReplacementContext.cs"/>
    <Reference Include="Mono.Cecil"><HintPath>$(SptRoot)/BepInEx/core/Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>
</Project>
